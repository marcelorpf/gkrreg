suppressPackageStartupMessages({
library(MASS)        # rlm(): M-estimator and MM-estimator
library(robustbase)  # lmrob()
library(quantreg)    # rq(): L1 / LAD regression
library(sm)          # h.select(): required for sigma_method = "s4"
})
fit_all_methods <- function(formula, data = NULL,
sigma_method = "s3", ...) {
ols      <- lm(formula, data = data)
h        <- hatvalues(ols)
wls_data <- if (is.null(data)) list(.h_wls = h) else
c(as.list(data), list(.h_wls = h))
wls <- lm(update(formula, . ~ .), data = wls_data, weights = 1 / .h_wls)
# suppressWarnings: rlm may warn about non-convergence on severe outliers
m  <- suppressWarnings(MASS::rlm(formula, data=data, psi=psi.huber, method="M"))
mm <- suppressWarnings(MASS::rlm(formula, data=data, method="MM"))
l1 <- quantreg::rq(formula, data=data, tau=0.5)
gk <- gkrr(formula, data=data, sigma_method=sigma_method, ...)
list(OLS=ols, WLS=wls, M=m, MM=mm, L1=l1, GKRR=gk)
}
# Consistent palette and line types across all comparison plots
.method_col <- c(OLS="black", WLS="royalblue", M="darkorange",
MM="purple",  L1="darkgreen",  GKRR="firebrick")
.method_lty <- c(OLS=2, WLS=3, M=4, MM=5, L1=6, GKRR=1)
.method_lwd <- c(OLS=1.5, WLS=1.5, M=1.5, MM=1.5, L1=1.5, GKRR=2.5)
add_fit_lines <- function(fits) {
for (nm in names(fits)) {
b <- coef(fits[[nm]])
abline(a=b[1], b=b[2], col=.method_col[nm],
lty=.method_lty[nm], lwd=.method_lwd[nm])
}
legend("topleft", bty="n", cex=0.75, legend=names(fits),
col=.method_col[names(fits)], lty=.method_lty[names(fits)],
lwd=.method_lwd[names(fits)])
}
coef_table <- function(fits, true_beta=NULL, digits=4) {
tab <- t(sapply(fits, function(f) round(coef(f), digits)))
if (!is.null(true_beta)) tab <- rbind(tab, True=round(true_beta, digits))
print(tab); invisible(tab)
}
