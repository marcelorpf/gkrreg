.mc_run <- function(n, pct_out, scenario, B_mc=500L, seed=1L) {
set.seed(seed)
beta_true <- c(1.7, 2.0)
methods   <- c("OLS","WLS","M","MM","L1","GKRR")
res <- setNames(lapply(methods, function(m) matrix(NA_real_, B_mc, 2)), methods)
for (b in seq_len(B_mc)) {
x <- runif(n, 10, 20); y <- beta_true[1] + beta_true[2]*x + rnorm(n)
if (pct_out > 0) {
k <- floor(n*pct_out); idx <- sample(n, k)
if (scenario==1L) y[idx] <- y[idx]+max(x)+5
if (scenario==2L) x[idx] <- max(x)+5
if (scenario==3L) { x[idx] <- max(x)+5; y[idx] <- y[idx]+max(y)+5 }
}
sm   <- if (scenario %in% c(0L,2L)) "s2" else "s3"
fits <- tryCatch(suppressWarnings(
fit_all_methods(y~x, data=data.frame(y=y,x=x), sigma_method=sm)),
error=function(e) NULL)
if (is.null(fits)) next
for (nm in methods) res[[nm]][b,] <- coef(fits[[nm]])[1:2]
}
t(sapply(methods, function(nm) {
vals <- res[[nm]][,2]; vals <- vals[is.finite(vals)]
c(Mean=mean(vals), Bias=mean(vals)-beta_true[2],
MSE=mean((vals-beta_true[2])^2))
}))
}
cat("\n=== Ex. 5: Monte Carlo comparison (n=100, B=500) ===\n")
for (nm in c("Scenario 0 -- no outliers",
"Scenario 1 -- 15% Y-space",
"Scenario 2 -- 10% X-space",
"Scenario 3 -- 10% leverage pts")) {
args <- list(
"Scenario 0 -- no outliers"      = list(pct=0.00, sc=0L),
"Scenario 1 -- 15% Y-space"      = list(pct=0.15, sc=1L),
"Scenario 2 -- 10% X-space"      = list(pct=0.10, sc=2L),
"Scenario 3 -- 10% leverage pts" = list(pct=0.10, sc=3L)
)[[nm]]
tab <- .mc_run(n=100, pct_out=args$pct, scenario=args$sc, B_mc=500L, seed=42L)
cat(sprintf("\n%s\n", nm)); print(round(tab, 4))
}
set.seed(5); n <- 60
x <- runif(n, 0, 10); y <- 1+2*x+rnorm(n); y[1:9] <- y[1:9]+20
fit_conv <- gkrr(y ~ x, sigma_method="s3")
cat("\n=== Ex. 6: Convergence ===\n")
print(round(fit_conv$criterion, 6))
cat("Converged in", fit_conv$iterations, "iterations\n")
plot(fit_conv, which=6, ask=FALSE)
set.seed(11); n <- 120
df <- data.frame(x1=runif(n,0,5), x2=runif(n,0,5), x3=runif(n,0,5))
df$y <- 1+2*df$x1-1.5*df$x2+0.5*df$x3+rnorm(n)
df$y[1:18] <- df$y[1:18]+30   # 15% Y-space outliers
fits_multi <- list(
OLS  = lm(y~x1+x2+x3, data=df),
M    = suppressWarnings(MASS::rlm(y~x1+x2+x3, data=df, method="M")),
MM   = suppressWarnings(MASS::rlm(y~x1+x2+x3, data=df, method="MM")),
GKRR = gkrr(y~x1+x2+x3, data=df, sigma_method="s3")
)
cat("\n=== Ex. 7: Multiple predictors (true: 1, 2, -1.5, 0.5) ===\n")
print(rbind(t(sapply(fits_multi, function(f) round(coef(f),3))),
True=c(1,2,-1.5,0.5)))
oldpar <- par(no.readonly = TRUE); on.exit(par(oldpar))
par(mfrow = c(2, 3))
plot(fits_multi$GKRR, which=1, ask=FALSE, main="Ex.7 -- Residuals vs. Fitted")
plot(fits_multi$GKRR, which=2, ask=FALSE, main="Ex.7 -- Observed vs. Fitted")
plot(fits_multi$GKRR, which=3, ask=FALSE, main="Ex.7 -- Weight vs. Residual")
plot(fits_multi$GKRR, which=4, ask=FALSE, main="Ex.7 -- Weight vs. Index")
plot(fits_multi$GKRR, which=5, ask=FALSE, main="Ex.7 -- QQ-plot")
plot(fits_multi$GKRR, which=6, ask=FALSE, main="Ex.7 -- Convergence")
par(oldpar)
set.seed(1); n <- 200
x <- runif(n, 0, 10); y <- 2+3*x+rnorm(n); y[1:30] <- y[1:30]+20
fit_s3 <- gkrr(y ~ x, sigma_method = "s3")
fit_s4 <- gkrr(y ~ x, sigma_method = "s4")
cat("\n=== Ex. 8: sigma_method = 's4' (n=200, 15% Y-outliers) ===\n")
cat(sprintf("S3: beta0=%.4f  beta1=%.4f  gamma2=%.4f\n",
coef(fit_s3)[1], coef(fit_s3)[2], fit_s3$gamma2))
cat(sprintf("S4: beta0=%.4f  beta1=%.4f  gamma2=%.4f\n",
coef(fit_s4)[1], coef(fit_s4)[2], fit_s4$gamma2))
cat("True: beta0=2.0  beta1=3.0\n")
oldpar <- par(no.readonly = TRUE); on.exit(par(oldpar))
par(mfrow = c(1, 2))
plot(x, y, pch=19, col="grey70", main="Ex.8 -- S3 vs. S4", xlab="x", ylab="y")
points(x[1:30], y[1:30], col="red", pch=17, cex=1.1)
abline(fit_s3, col="steelblue",  lwd=2, lty=2)
abline(fit_s4, col="firebrick",  lwd=2)
legend("topleft", c("GKRR (S3)","GKRR (S4)","Outliers"),
col=c("steelblue","firebrick","red"),
lty=c(2,1,NA), pch=c(NA,NA,17), lwd=2, bty="n")
plot(fit_s4, which=3, ask=FALSE, main="Ex.8 -- S4 Weight vs. Residual")
par(oldpar)
set.seed(42); n <- 80
x <- runif(n, 0, 10); y <- 2+3*x+rnorm(n); y[1:12] <- y[1:12]+25
cat("\n=== Ex. 9: sigma_method = 'auto' ===\n")
fit_auto <- gkrr(y ~ x, sigma_method = "auto",
auto_args = list(B = 99, seed = 1))
cat("Selected method:", fit_auto$sigma_method, "\n")
cat("gamma^2:", round(fit_auto$gamma2, 4), "\n")
summary(fit_auto)
# "auto" + boot = TRUE: the bootstrap uses the selected method to
# re-estimate gamma^2 on each replicate
cat("\n'auto' + boot = TRUE:\n")
fit_auto_b <- gkrr(y ~ x, sigma_method = "auto",
auto_args  = list(B = 49, seed = 1),
boot       = TRUE,
boot_args  = list(B = 199, seed = 2))
cat("Selected method:", fit_auto_b$sigma_method, "\n")
summary(fit_auto_b)
df_inf <- data.frame(y=y, x=x)
fit_sw <- gkrr(y ~ x, data=df_inf, sigma_method="s3")
cat("\n=== Ex. 10: summary() with sandwich (default) ===\n")
summary(fit_sw)
cat("\nSandwich covariance matrix:\n")
print(round(vcov(fit_sw), 6))
fit_b <- gkrr(y ~ x, data=df_inf, sigma_method="s3",
boot=TRUE, boot_args=list(B=999, type="bca", seed=1))
cat("\n=== Ex. 11: summary() with boot = TRUE (BCa, B=999) ===\n")
summary(fit_b)
boot_ext <- gkrr_boot(fit_sw, B=999, type="percentile", seed=2)
cat("\n=== Ex. 12: summary() with external bootstrap (percentile, B=999) ===\n")
summary(fit_sw, boot=boot_ext)
cat("\n=== Ex. 13: Bootstrap diagnostic plots ===\n")
plot(fit_b$boot, which=1, ask=FALSE)
plot(fit_b$boot, which=2, ask=FALSE)
# 3x3 scatter matrix with 2 predictors
set.seed(15); n2 <- 100
df2 <- data.frame(x1=runif(n2,0,5), x2=runif(n2,0,5))
df2$y <- 2+1.5*df2$x1-0.8*df2$x2+rnorm(n2); df2$y[1:15] <- df2$y[1:15]+20
fit2 <- gkrr(y~x1+x2, data=df2, sigma_method="s3",
boot=TRUE, boot_args=list(B=999, type="bca", seed=3))
cat("\n=== Ex. 13b: 3x3 scatter matrix (2 predictors) ===\n")
summary(fit2)
plot(fit2$boot, which=2, ask=FALSE)
cat("\n=== Ex. 14: CI comparison -- percentile / normal / BCa ===\n")
for (tp in c("percentile","normal","bca")) {
b <- gkrr_boot(fit_sw, B=999, type=tp, seed=1)
cat(sprintf("%-12s  x: [%.4f, %.4f]   SE=%.4f   p=%.4f\n",
tp, b$ci["lower","x"], b$ci["upper","x"],
b$se["x"], b$pval["x"]))
}
