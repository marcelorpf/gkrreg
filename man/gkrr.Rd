summary(fit_auto)
}

# Fit with bootstrap inference (BCa, B = 999 by default)
\donttest{
fit_b <- gkrr(y ~ x, sigma_method = "s3", boot = TRUE,
              boot_args = list(B = 499, seed = 1))
summary(fit_b)
plot(fit_b)
