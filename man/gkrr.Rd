# Basic fit with sandwich inference (default)
fit <- gkrr(y ~ x, sigma_method = "s3")
summary(fit)

# Using S4 estimator (AICc bandwidth)
\donttest{
fit_s4 <- gkrr(y ~ x, sigma_method = "s4")
summary(fit_s4)
}

# Automatic estimator selection
\donttest{
fit_auto <- gkrr(y ~ x, sigma_method = "auto",
